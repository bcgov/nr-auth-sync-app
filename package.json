{
  "name": "nr-auth-sync-app",
  "version": "1.0.0",
  "author": "Matthew Bystedt <matthew.bystedt@gov.bc.ca>",
  "description": "Auth Sync App keeps target system roles up-to-date",
  "bin": {
    "nr-auth-sync-app": "./bin/run.js"
  },
  "type": "module",
  "dependencies": {
    "@oclif/core": "^4.11.7",
    "@oclif/plugin-help": "^6.2.50",
    "@oclif/plugin-plugins": "^5.4.74",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/core": "^7.0.6",
    "@octokit/oauth-app": "^8.0.3",
    "@octokit/plugin-paginate-rest": "^14.0.0",
    "@octokit/plugin-rest-endpoint-methods": "^17.0.0",
    "axios": "^1.18.0",
    "class-transformer": "^0.5.1",
    "inversify": "^8.1.0",
    "nodemailer": "^9.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@oclif/test": "^4.1.19",
    "@types/chai": "file:@types/chai",
    "@types/ejs": "^3.1.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "chai": "^6.2.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "mocha": "^11.7.6",
    "oclif": "^4.23.16",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json",
    "!**/*.tsbuildinfo",
    "LICENSE",
    "README.md"
  ],
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "oclif": {
    "commands": "./dist/commands",
    "bin": "authtool",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint \"src/**/*.ts\"",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm lint",
    "pack": "",
    "prepack": "oclif manifest && oclif readme",
    "test": "jest",
    "e2e": "jest --config=jest.e2e.config.js",
    "version": "oclif readme && git add README.md"
  },
  "repository": {
    "type": "git",
    "url": "https://apps.nrs.gov.bc.ca/int/stash/scm/appdev/vault-policy.git"
  },
  "types": "dist/index.d.ts"
}
